// euler method
#include <iostream>
#include<cmath>
#include<iomanip>
using namespace std;
int main(){
	int n;
	cout<<"enter the size of array x"<<endl;
	cin>>n;
	cout<<"enter the size of array y"<<endl;
	cin>>n;
	double x[n];
	double y[n];
	 x[0]=0;
	 y[0]=1;
	for(int i=1;i<n;i++){
		x[i]=x[i-1]+0.1;
		y[i]=y[i-1]+(0.1*(x[i-1]+y[i-1]));
	}
	for (int i=0;i<n;i++){
		cout<<fixed<<setprecision(8)<<y[i]<<'\n'<<endl;
	}
	return 0;
}
