//runga kutta method
#include <iostream>
#include<cmath>
#include<iomanip>
using namespace std;
int main(){
	int n;
	double h;
	cout<<"enter the value of h"<<endl;
	cin>>h; 
	cout<<"enter the size of array x"<<endl;
	cin>>n;
	cout<<"enter the size of array y"<<endl;
	cin>>n;
	double x[n];
	double y[n];
	 x[0]=0;
	 y[0]=1;
	 for (int i=1;i<n;i++){
	 	x[i]=x[i-1]+h;
	 	double k1=x[i-1]+y[i-1];
	 	double k2=x[i-1]+(h/2)+y[i-1]+(h/2)*k1;
	 	double k3=x[i-1]+(h/2)+y[i-1]+(h/2)*k2;
	 	double k4=x[i-1]+h+y[i-1]+(h)*k3;
	 	y[i]=y[i-1]+(h/6)*(k1+2*k2+2*k3+k4);
	 }
	 for (int i=0;i<n;i++){
	 	cout<<fixed<<setprecision(8)<<y[i]<<'\n'<<endl;
	 }
	 return 0;
}
